# Copy to .env and change every secret before any real deployment.

# --- database ---
POSTGRES_PASSWORD=vayu_owner_pw          # owner: creates tables, runs the demo reset
APP_DB_PASSWORD=vayu_app_pw              # restricted role "vayu_app" used by the API
# Inside docker-compose these two are built for you. Set them yourself for a cloud copy:
DATABASE_URL=postgresql+psycopg://vayu_app:vayu_app_pw@db:5432/vayu
OWNER_DATABASE_URL=postgresql+psycopg://vayu:vayu_owner_pw@db:5432/vayu

# --- login ---
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
OTP_DEMO_CODE=482913                     # demo only; replace with a real OTP provider on the base network

# --- network ---
CORS_ORIGINS=http://localhost:3000       # comma-separated allow-list
NEXT_PUBLIC_API_URL=http://localhost:8000
MQTT_URL=mqtt://mqtt:1883

# --- models and files ---
MODEL_DIR=/app/models
MINIO_ROOT_USER=vayu
MINIO_ROOT_PASSWORD=vayu-minio-secret

# --- classification banner shown on every page and export ---
CLASSIFICATION_LABEL=DEMO DATA – UNCLASSIFIED

# --- demo logins on the login page (one-tap role buttons, password and code shown) ---
# Build-time flag for the web image. Set to "off" for any real deployment.
NEXT_PUBLIC_DEMO_MODE=on
